# ChainSentinel backend environment variables
# Copy to src/backend/.env (or src/.env) and fill values. NEVER commit .env.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (Docker Compose PostgreSQL 16) ---
# Host port is 5433 because a local PostgreSQL service already uses 5432 on this machine.
DATABASE_URL=postgres://bobathon:bobathon@localhost:5433/chain_sentinel
TEST_DATABASE_URL=postgres://bobathon:bobathon@localhost:5433/chain_sentinel_test

# --- Bob assistant (local engine — no external API needed) ---
BOB_ENABLED=true

# --- Data generation ---
SEED=20260914

# --- Fleet redeployment ---
REDEPLOY_RADIUS_KM=150

# --- Combined risk weights ---
RISK_ALPHA=0.5
RISK_BETA=0.5

# --- Excursion evaluation (defaults; policy thresholds live in the DB) ---
SENSOR_INTERVAL_MIN=15
EXCURSION_GROUP_GAP_MINUTES=30

# --- Grounded AI incident brief (optional; disabled by default) ---
# Reuses BOB_API_URL/BOB_API_KEY when FEATURE_AI_INCIDENT_BRIEF=true.
FEATURE_AI_INCIDENT_BRIEF=false
AI_BRIEF_PROVIDER_TIMEOUT_MS=15000
AI_BRIEF_MAX_PROMPT_CHARS=12000
AI_BRIEF_MAX_RESPONSE_CHARS=8000

# --- AI Incident Commander (Feature 2; disabled by default) ---
# Reuses the provider/grounding infrastructure of the incident brief. No AI or MCP
# orchestration occurs while this flag is false.
FEATURE_AI_INCIDENT_COMMANDER=false

# --- AI provider for Bob Chat + Incident Commander ---
# auto = BOB_API_URL gateway > watsonx > gemini > groq; or force one:
#   AI_PROVIDER=watsonx | gemini | groq | bob_gateway | none
# With a provider configured, the LLM chooses the read-only MCP tools and writes the
# answers/summaries (grounding-checked). Without one, the deterministic fallback runs.
AI_PROVIDER=auto
AI_AGENT_MAX_TOOL_CALLS=6
AI_AGENT_MAX_PROMPT_CHARS=30000

# --- IBM watsonx.ai / Granite (preferred provider) ---
# Placeholders only. Replace with the real values in src/backend/.env when provided.
# The model ID must be a chat model supported by your watsonx.ai project
# (check with: GET {WATSONX_URL}/ml/v1/foundation_model_specs?version=2024-10-01&filters=function_text_chat).
# Secrets stay server-side and are never exposed to the frontend. See docs/GRANITE_CONFIGURATION.md.
WATSONX_API_KEY=YOUR_WATSONX_API_KEY_HERE
WATSONX_PROJECT_ID=YOUR_WATSONX_PROJECT_ID_HERE
WATSONX_URL=YOUR_WATSONX_URL_HERE
WATSONX_MODEL_ID=ibm/granite-4-h-small

# --- Google Gemini (optional alternative provider) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_ID=gemini-2.0-flash

# --- Groq (optional alternative provider) ---
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL_ID=llama-3.3-70b-versatile
